# --- Database ---
DATABASE_URL=postgresql://medassist:medassist_dev_only@localhost:5432/medassist

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth ---
# LOCAL DEV ONLY. Generate a real secret for any other environment:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-min-32-chars-long-xxxx
JWT_EXPIRES_IN=7d

# --- RAG / embeddings ---
# 'local' = in-process transformers.js (Xenova/multilingual-e5-small, 384 dims, offline)
# 'hf'    = HuggingFace Inference API (intfloat/multilingual-e5-large, 1024 dims)
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
# Required only for EMBEDDING_PROVIDER=hf; needs Inference Providers permission
HF_TOKEN=

# --- LLM ---
# auto = fallback ladder Gemini -> Cerebras (default); gemini/cerebras = single provider; mock = tests
# NOTE (2026-10-11): Groq disabled permanently per user instruction (429 throttling in P5).
# Keys are dedicated to THIS application only — never reuse keys from other projects.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b